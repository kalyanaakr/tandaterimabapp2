# Salin file ini menjadi ".env" lalu isi sesuai environment Anda.

# --- "DATABASE" (spreadsheet Google tempat data aplikasi ini disimpan) ---
# Boleh spreadsheet baru & kosong, ATAU sama persis dengan MASTER_SHEET_ID di
# bawah kalau mau digabung jadi satu spreadsheet. Ambil ID dari URL:
# https://docs.google.com/spreadsheets/d/<ID_INI>/edit
# Tab-tab di dalamnya (master_bundle, transaksi_perpindahan, dst) dibuat
# OTOMATIS oleh aplikasi saat pertama kali dipakai.
DB_SHEET_ID=1bgBsR4U5u5dgjTONE1RrMPHV2-prJXjfLd9Kf2Z5Jsc

# --- GOOGLE SHEETS - MASTER BAPP (sheet yang sudah ada) ---
MASTER_SHEET_ID=1bgBsR4U5u5dgjTONE1RrMPHV2-prJXjfLd9Kf2Z5Jsc
MASTER_SHEET_WORKSHEET_NAME=data
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# --- GOOGLE DRIVE (opsional, kosongkan jika belum dipakai) ---
DRIVE_ROOT_FOLDER_ID=
